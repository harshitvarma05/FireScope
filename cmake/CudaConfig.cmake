if(FIRESCOPE_ENABLE_CUDA)
    include(CheckLanguage)
    check_language(CUDA)
    if(CMAKE_CUDA_COMPILER)
        if(NOT DEFINED CMAKE_CUDA_ARCHITECTURES)
            set(CMAKE_CUDA_ARCHITECTURES native)
        endif()
        enable_language(CUDA)
        find_package(CUDAToolkit REQUIRED)
        target_sources(firescope_core PRIVATE src/backends/cuda/CUDABackend.cu)
        target_include_directories(firescope_core PRIVATE src/backends/cuda)
        target_compile_definitions(firescope_core PUBLIC FIRESCOPE_HAS_CUDA=1)
        target_compile_options(firescope_core PRIVATE $<$<COMPILE_LANGUAGE:CUDA>:--fmad=false>)
        target_link_libraries(firescope_core PUBLIC CUDA::cudart)
        set_target_properties(firescope_core PROPERTIES CUDA_STANDARD 17 CUDA_STANDARD_REQUIRED ON)
    else()
        message(STATUS "CUDA compiler unavailable; CPU and other supported backends remain enabled")
    endif()
endif()
