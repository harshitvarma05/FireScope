if(APPLE AND FIRESCOPE_ENABLE_METAL)
    enable_language(OBJCXX)
    find_library(FIRESCOPE_METAL_FRAMEWORK Metal REQUIRED)
    find_library(FIRESCOPE_FOUNDATION_FRAMEWORK Foundation REQUIRED)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS src/backends/metal/wildfire.metal)
    file(READ ${CMAKE_CURRENT_SOURCE_DIR}/src/backends/metal/wildfire.metal FIRESCOPE_METAL_SOURCE)
    configure_file(cmake/MetalSources.hpp.in generated/MetalSources.hpp @ONLY)
    target_sources(firescope_core PRIVATE src/backends/metal/MetalBackend.mm)
    set_target_properties(firescope_core PROPERTIES OBJCXX_STANDARD 17 OBJCXX_STANDARD_REQUIRED ON)
    target_include_directories(firescope_core PRIVATE src/backends/metal ${CMAKE_CURRENT_BINARY_DIR}/generated)
    target_compile_definitions(firescope_core PUBLIC FIRESCOPE_HAS_METAL=1)
    target_compile_options(firescope_core PRIVATE $<$<COMPILE_LANGUAGE:OBJCXX>:-fobjc-arc>)
    target_link_libraries(firescope_core PUBLIC ${FIRESCOPE_METAL_FRAMEWORK} ${FIRESCOPE_FOUNDATION_FRAMEWORK})
    if(BUILD_TESTING)
        add_executable(test_metal_smoke tests/test_metal_smoke.mm)
        set_target_properties(test_metal_smoke PROPERTIES OBJCXX_STANDARD 17 OBJCXX_STANDARD_REQUIRED ON)
        target_compile_options(test_metal_smoke PRIVATE -fobjc-arc)
        target_link_libraries(test_metal_smoke PRIVATE ${FIRESCOPE_METAL_FRAMEWORK} ${FIRESCOPE_FOUNDATION_FRAMEWORK})
        add_test(NAME standalone_metal_compute COMMAND test_metal_smoke)
        set_tests_properties(standalone_metal_compute PROPERTIES SKIP_RETURN_CODE 77)
    endif()
endif()
